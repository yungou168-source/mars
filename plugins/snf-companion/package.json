{
  "name": "@sovereign-nation/snf-companion",
  "version": "1.0.0",
  "description": "AI companion plugin for Sovereign Nation Framework — companion creation, growth, daily missions, and social interaction",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
